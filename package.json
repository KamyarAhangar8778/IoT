{
  "name": "achaemenid-iot",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "DASHBOARD"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=DASHBOARD",
    "build": "npm run build --workspace=DASHBOARD",
    "lint": "npm run lint --workspace=DASHBOARD",
    "start": "npm run start --workspace=DASHBOARD",
    "format:esp": "bash scripts/format-esp.sh",
    "format:esp:check": "bash scripts/format-esp.sh --check",
    "lint:esp": "bash scripts/lint-esp.sh",
    "tidy:esp": "bash scripts/tidy-esp.sh",
    "compile:esp": "pio run -d .",
    "size:esp": "bash scripts/size-esp.sh",
    "check:esp": "npm run format:esp:check && npm run lint:esp"
  }
}
